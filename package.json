{
  "name": "aegisite",
  "description": "Aegisub Website",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "repository": "https://github.com/Aegisub/aegisite",
  "license": "MIT",
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "hugo new",
    "prestart": "npm run clean",
    "start": "hugo server --bind=0.0.0.0 --disableFastRender",
    "prebuild": "npm run clean",
    "build": "hugo --gc --minify",
    "build:preview": "npm run build -D -F",
    "clean": "shx rm -rf public resources",
    "clean:install": "shx rm -rf package-lock.json node_modules ",
    "lint": "npm run -s lint:scripts && npm run -s lint:styles && npm run -s lint:markdown",
    "lint:scripts": "eslint assets/js config functions",
    "lint:styles": "stylelint \"assets/scss/**/*.{css,sass,scss,sss,less}\"",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "lint:markdown-fix": "markdownlint-cli2-fix \"*.md\" \"content/**/*.md\"",
    "server": "hugo server",
    "test": "npm run -s lint",
    "env": "env",
    "precheck": "npm version",
    "check": "hugo version",
    "copy:katex-fonts": "shx cp ./node_modules/katex/dist/fonts/* ./static/fonts/"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "autoprefixer": "^10.5.2",
    "bootstrap": "^5.3.8",
    "clipboard": "^2.0",
    "eslint": "^8.35",
    "flexsearch": "^0.7.43",
    "highlight.js": "^11.11.1",
    "highlightjs-ass": "github:TypesettingTools/highlightjs-ass",
    "hugo-extended": "0.164.0",
    "instant.page": "^5.1",
    "katex": "^0.16.47",
    "markdownlint-cli2": "^0.6.0",
    "netlify-plugin-submit-sitemap": "^0.4.0",
    "node-fetch": "^3.3",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "shx": "^0.4.0",
    "stylelint": "^15.2",
    "stylelint-config-standard-scss": "^7.0"
  }
}
